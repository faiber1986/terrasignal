# Origin of the FastAPI backend. The browser calls it directly (CORS), so this
# must be reachable from the user's machine, not from the Next.js server.
#
# Origin only — no trailing slash, no /api/v1 (the client appends it).
#
# NEXT_PUBLIC_* values are inlined at BUILD time. On Vercel, set this in Project
# Settings -> Environment Variables and then redeploy; editing it after a build
# has no effect until the next one.
#
# Local:    http://127.0.0.1:8000   (127.0.0.1, not localhost — see lib/api/client.ts)
# Deployed: https://<your-backend-host>
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
